<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF8AE8F5"
                android:endColor="#FF5B86FF"
                android:angle="315" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E96DE4F4"
                android:endColor="#E94D6FFF"
                android:angle="315" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
